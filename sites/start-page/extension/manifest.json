{
  "manifest_version": 3,
  "name": "APEX 360 START",
  "short_name": "APEX 360",
  "version": "0.1.0",
  "description": "Maverick's new tab: clock, search, today's 3 things, a focus timer and quick tiles. Everything is saved on this computer only.",
  "chrome_url_overrides": {
    "newtab": "index.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "apex360-start@apex360marketing.ai",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
